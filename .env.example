# Example only: copy to .env.local and fill in. Never commit real values.
# This server's PostgreSQL (institutions/). The application always runs as the role
# ductura_app (institutions/db.js); in production this login is only a member of it.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/ductura
# Owner of the tables, for `pnpm db:migrate` and `pnpm admin:stvori`; empty means DATABASE_URL.
DATABASE_OWNER_URL=
# Institution_server for POST /internal/v1/institutions (Ductus#2028 c.6993786629 §2).
INSTITUTION_SERVER_URL=http://127.0.0.1:4000
# Shared secret with Institution_server, at least 32 characters, generated locally
# (for example: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))").
DUCTURA_PROVISIONING_TOKEN=
# Platform admin session (admin/, lib/admin-sesija.js): HMAC key of the ductura_admin
# cookie, at least 32 characters, generated locally the same way. Changing it ends all sessions.
DUCTURA_ADMIN_TOKEN_SECRET=
