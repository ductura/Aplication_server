{
  "name": "aplication-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "^24.11.0 || ^26.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node --test test/build-output.test.mjs test/server.test.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test test/health.test.mjs test/javascript-only.test.mjs test/ci-workflow.test.mjs test/institutions.test.mjs test/institutions-podigni.test.mjs",
    "test:db": "node --test --test-concurrency=1 test/institutions-db.test.mjs test/institutions-podigni-db.test.mjs",
    "db:migrate": "node institutions/migrate.js",
    "instance:podigni": "node institutions/podigni.js"
  },
  "dependencies": {
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.6",
    "eslint": "10.15.0",
    "globals": "17.14.0"
  }
}
